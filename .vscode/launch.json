{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Setup: get the dataset",
      "type": "debugpy",
      "request": "launch",
      "module": "lab.get_data",
      "console": "integratedTerminal"
    },
    {
      "name": "Setup: set your API key",
      "type": "debugpy",
      "request": "launch",
      "module": "lab.set_key",
      "console": "integratedTerminal"
    },
    {
      "name": "Run the lab interface",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "ui/app.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Preflight (local checks only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/preflight.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Evaluate the rules",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "lab.evaluate_rules"
    }
  ]
}
