{
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Deliberately no python.defaultInterpreterPath. It takes one literal path,
  // and .venv/bin/python is wrong on Windows (.venv/Scripts/python.exe).
  // Auto-discovery finds a workspace .venv on all three platforms; if it does
  // not, run the "Python: Select Interpreter" command.

  // PYTHONPATH is what actually makes `import lab` work from a terminal.
  "terminal.integrated.env.osx": { "PYTHONPATH": "${workspaceFolder}" },
  "terminal.integrated.env.linux": { "PYTHONPATH": "${workspaceFolder}" },
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}" },

  // python.analysis.* is Pylance-only and inert without it, so the same thing
  // is set for basedpyright. Both are listed so the repo works in either IDE.
  "basedpyright.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],

  // Completions and go-to-definition without a wall of type errors. This is a
  // teaching repo: participants should see their own mistakes, not the type
  // checker's opinions about pandas.
  "basedpyright.analysis.typeCheckingMode": "off",

  "python.envFile": "${workspaceFolder}/.env",
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true },
  "search.exclude": { "**/.venv": true }
}
