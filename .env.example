# Copy to .env and fill in from your welcome email.
# Antigravity and VS Code load .env automatically for the Python extension.

# Folder holding the case_* directories.
LAB_DATA_DIR=./data/labels

# From your welcome email. Setting LAB_PROJECT_ID lets preflight catch the case
# where gcloud is still pointed at one of your own projects.
LAB_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
# Gemini 3.x is only served from the `global` endpoint on Vertex.
GOOGLE_CLOUD_LOCATION=global
LAB_MODEL=gemini-3.5-flash

# Set to 0 if the timeline playhead misbehaves; the timeline still works.
LAB_REPLAY=1
