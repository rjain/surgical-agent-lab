# Copy to .env and fill in. Everything in the lab reads this file directly, so
# it works the same from the terminal, the debugger, Streamlit and pytest.

# Your Gemini API key — https://aistudio.google.com/apikey
# Both of these forms work:
#   LAB_GEMINI_API_KEY=your-key
#   export LAB_GEMINI_API_KEY="your-key"
LAB_GEMINI_API_KEY=

# Folder holding the case_* directories. Leave unset if the data sits at
# data/labels/ inside this repository, which is where the code looks by default.
# LAB_DATA_DIR=

# Override the model if you want to try another. Defaults to gemini-flash-latest.
# LAB_MODEL=gemini-flash-latest
